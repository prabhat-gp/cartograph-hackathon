{
  "name": "cartograph-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Cartograph — Google Maps for your codebase, inside ChatGPT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "usage": "tsx scripts/usage.ts",
    "sponsors": "tsx --env-file-if-exists=.env scripts/sponsors.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "zetaris:setup": "tsx --env-file-if-exists=.env scripts/zetaris-setup.ts",
    "why": "tsx --env-file-if-exists=.env scripts/why.ts",
    "hmem:conformance": "HMEM_IMPL=$PWD/src/memory/hmem.ts tsx third_party/meterless-hmem-conformance/runner.ts",
    "build:site": "npm --prefix site run build",
    "build": "npm run build:web && npm run build:site"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
