# NVIDIA build.nvidia.com -> profile -> API Keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Meterless Nightshift runtime (OpenAI-compatible, runs locally)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=

# Zetaris REST API (organisation 1 on a local install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# If the API key is refused ("Not Allowed"), Cartograph signs in instead:
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Optional: force a provider ("meterless" or "nvidia")
CARTOGRAPH_PROVIDER=
# Per-tier model overrides, e.g. CARTOGRAPH_NVIDIA_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Budget guard for the free NVIDIA quota (calls stop before these are crossed)
CARTOGRAPH_MAX_CALLS_PER_DAY=1000
CARTOGRAPH_MAX_TOKENS_PER_DAY=3000000
CARTOGRAPH_MAX_CALLS_PER_MINUTE=30

# Cartograph evidence store (Postgres). Zetaris reads it as a JDBC datasource.
CARTOGRAPH_PG_URL=postgres://cartograph:password@localhost:5433/cartograph
# Read-only GitHub token for ingestion (raises the API limit to 5000/hour)
GITHUB_TOKEN=

# Server port for npm start (Docker uses 8000)
PORT=8000
