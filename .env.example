# NVIDIA build.nvidia.com -> profile -> API Keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Meterless Nightshift runtime (OpenAI-compatible, runs locally)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=

# Zetaris REST API
ZETARIS_URL=http://localhost:8888
ZETARIS_API_KEY=

# Optional: force a provider ("meterless" or "nvidia") and pick the default model
CARTOGRAPH_PROVIDER=
CARTOGRAPH_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Budget guard for the free NVIDIA quota (calls stop before these are crossed)
CARTOGRAPH_MAX_CALLS_PER_DAY=1000
CARTOGRAPH_MAX_TOKENS_PER_DAY=3000000
CARTOGRAPH_MAX_CALLS_PER_MINUTE=30
