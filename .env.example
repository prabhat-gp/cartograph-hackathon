# ---- AI provider: NVIDIA Nemotron, through Meterless Nightshift when it's running ----
# Meterless Nightshift runtime (Console → URL and API key). When the key is set it is the primary provider.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
# NVIDIA build.nvidia.com → profile → API Keys. Used directly while Nightshift isn't running.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: force a provider ("meterless" or "nvidia"), or override a tier's model,
# e.g. CARTOGRAPH_NVIDIA_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CARTOGRAPH_PROVIDER=
# Budget guard for the free NVIDIA quota (calls stop before these are crossed)
CARTOGRAPH_MAX_CALLS_PER_DAY=1000
CARTOGRAPH_MAX_TOKENS_PER_DAY=3000000
CARTOGRAPH_MAX_CALLS_PER_MINUTE=30
# Cap on full (non-cached) maps per day
CARTOGRAPH_MAX_MAPS_PER_DAY=25

# ---- Data: Zetaris (REST API, organisation 1 on a local install) ----
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# If the API key is refused ("Not Allowed"), Cartograph signs in instead:
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Evidence store (Postgres). Zetaris reads it as a JDBC datasource.
CARTOGRAPH_PG_URL=postgres://cartograph:password@localhost:5433/cartograph

# ---- Server ----
PORT=8787
# Public HTTPS URL of this server (your tunnel), used in links and webhooks
PUBLIC_URL=
# Secret URL prefix for remote access (generated by scripts/dev.sh). The MCP
# server URL is <tunnel>/<token>/mcp. Treat it like a password.
CARTOGRAPH_ACCESS_TOKEN=
# Local folders that may be mapped (comma-separated absolute paths). Default: none.
CARTOGRAPH_LOCAL_REPOS=

# ---- GitHub ----
# Read-only token: GitHub API limits for mapping and history ingest; also lets Cartograph comment on drift
GITHUB_TOKEN=
# Secret you also paste into the GitHub repo's webhook settings (push events → drift review)
GITHUB_WEBHOOK_SECRET=
