# The server's environment (copy to ~/cartograph/cartograph.env). Same keys as
# .env.example, plus the public-mode and storage settings below.
CARTOGRAPH_PUBLIC=1
PORT=8787
PUBLIC_URL=https://example.com
NVIDIA_API_KEY=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_UI_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
CARTOGRAPH_PG_URL=postgres://cartograph:password@localhost:5433/cartograph
# A token that reads public repos only (GitHub API limits); expires after judging
GITHUB_TOKEN=
# Repos whose commits may get a drift comment (comma-separated owner/name)
CARTOGRAPH_COMMENT_REPOS=
CARTOGRAPH_MAX_MAPS_PER_DAY=25
CARTOGRAPH_MAX_CALLS_PER_DAY=1000
CARTOGRAPH_MAX_TOKENS_PER_DAY=3000000
# Everything the server writes, outside the release folders
CARTOGRAPH_DATA_DIR=/home/ubuntu/cartograph/data
CARTOGRAPH_USAGE_FILE=/home/ubuntu/cartograph/data/usage.jsonl
CARTOGRAPH_MEMORY_DIR=/home/ubuntu/cartograph/data/memory
CARTOGRAPH_REPOS_DIR=/home/ubuntu/cartograph/data/ingest
CARTOGRAPH_LOG_DIR=/home/ubuntu/cartograph/data/logs
